+WANTED = ("fast_sequences", "run_sequences", "compressed_block", "SequenceTable", "Huffman", "fast_loop", "Xxh64",
+          "ZSTD_decompressSequences", "ZSTD_buildFSETable", "ZSTD_decompressMultiFrame", "HUF_decompress4X")
+
+
+def disassemble(harness, out):
+    listing = subprocess.run(["nm", "-S", "--defined-only", str(harness)], check=True, capture_output=True, text=True)
+    count = 0
+    for line in listing.stdout.splitlines():
+        fields = line.split()
+        if len(fields) != 4 or not any(wanted in fields[3] for wanted in WANTED):
+            continue
+        start, size = int(fields[0], 16), int(fields[1], 16)
+        if size < 64:
+            continue
+        count += 1
+        with (out / f"objdump-{count:02d}.txt").open("w") as text:
+            text.write(f"{fields[3]} {size} bytes\n")
+            text.flush()
+            subprocess.run(["objdump", "-d", "--no-show-raw-insn", "-C", f"--start-address={start:#x}",
+                            f"--stop-address={start + size:#x}", str(harness)], check=False, stdout=text)
+
+
 def ratio(zipper, other):
     return None if zipper is None or not other else zipper / other
 
