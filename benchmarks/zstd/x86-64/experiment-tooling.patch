diff --git a/scripts/m35_ab.py b/scripts/m35_ab.py
new file mode 100644
index 00000000..637305bb
--- /dev/null
+++ b/scripts/m35_ab.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Experiment tooling for m35-exp branches only: time Zipper's Zstandard decoder at a base build
+against the build of this ref and against libzstd, interleaved in one job on one runner.
+
+Each sample is one `zipper-decode-bench decode` process, which times only the decode call and checks
+every byte. Rounds run the rows in a new seeded order after one warmup round.
+"""
+import argparse
+import json
+from pathlib import Path
+import random
+import statistics
+import subprocess
+import tempfile
+from m31_decoders import built_source, checked_corpus
+
+
+def sample(harness, decoder, stream, original):
+    with tempfile.TemporaryDirectory() as folder:
+        report = Path(folder) / "row.json"
+        subprocess.run([str(harness), "decode", "zstd", decoder, str(stream), str(original), str(report)], check=True)
+        return json.loads(report.read_text())
+
+
+def apart(stats, first, second):
+    return stats[first]["max"] < stats[second]["min"] or stats[second]["max"] < stats[first]["min"]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--base", type=Path, required=True)
+    parser.add_argument("--new", type=Path, required=True)
+    parser.add_argument("--corpus", type=Path, required=True)
+    parser.add_argument("--rounds", type=int, default=15)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    corpus = args.corpus.resolve(strict=True)
+    original = corpus / built_source(corpus)["tar"]
+    manifest = checked_corpus(corpus / "streams", original)
+    stream = corpus / "streams" / manifest["streams"]["zstd"]["file"]
+    new = args.new.resolve(strict=True)
+    rows = {"base": (args.base.resolve(strict=True), "zipper"), "new": (new, "zipper"), "libzstd": (new, "libzstd")}
+    order = list(rows)
+    shuffler = random.Random(35)
+    samples = {name: [] for name in rows}
+    for round_number in range(args.rounds + 1):
+        shuffler.shuffle(order)
+        for name in order:
+            harness, decoder = rows[name]
+            row = sample(harness, decoder, stream, original)
+            if round_number > 0:
+                samples[name].append(row["seconds"])
+    stats = {name: {"median": statistics.median(values), "min": min(values), "max": max(values), "samples": values}
+             for name, values in samples.items()}
+    lines = ["| Row | Median ms | Lowest | Highest |", "| --- | ---: | ---: | ---: |"]
+    for name, row in stats.items():
+        lines.append(f"| {name} | {row['median'] * 1000:.1f} | {row['min'] * 1000:.1f} | {row['max'] * 1000:.1f} |")
+    for first, second in (("new", "base"), ("new", "libzstd"), ("base", "libzstd")):
+        ratio = stats[first]["median"] / stats[second]["median"]
+        verdict = "apart" if apart(stats, first, second) else "overlap"
+        lines.append(f"\n{first} over {second}: {ratio:.3f}, ranges {verdict}")
+    args.out.write_text(json.dumps({"rounds": args.rounds, "rows": stats}, indent=2) + "\n")
+    args.out.with_suffix(".md").write_text("\n".join(lines) + "\n")
+    print("\n".join(lines))
+
+
+if __name__ == "__main__":
+    main()
