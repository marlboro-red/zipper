+#[derive(Default)]
+struct FixedBlock {
+    bytes: Vec<u8>,
+    buffer: u32,
+    count: u32,
+}
+
+impl FixedBlock {
+    fn put(&mut self, value: u32, count: u32) {
+        self.buffer |= value << self.count;
+        self.count += count;
+        while self.count >= 8 {
+            self.bytes.push(self.buffer as u8);
+            self.buffer >>= 8;
+            self.count -= 8;
+        }
+    }
+
+    // SPEC(RFC 1951 3.1.1): Huffman codes are packed starting with their most significant bit.
+    fn code(&mut self, (code, length): (u32, u32)) {
+        for bit in (0..length).rev() {
+            self.put((code >> bit) & 1, 1);
+        }
+    }
+
+    // SPEC(RFC 1951 3.2.6): the fixed code gives literals 0 to 143 the 8-bit codes from 0x30,
+    // length symbols 256 to 279 the 7-bit codes from 0, and distances 5-bit codes.
+    fn final_block(literals: &[u8], then_three_from_four_back: bool) -> Vec<u8> {
+        const END_OF_BLOCK: (u32, u32) = (0, 7);
+        const LENGTH_3: (u32, u32) = (1, 7);
+        const DISTANCE_4: (u32, u32) = (3, 5);
+        let mut block = Self::default();
+        block.put(0b011, 3);
+        for &byte in literals {
+            assert!(byte < 144);
+            block.code((0x30 + u32::from(byte), 8));
+        }
+        if then_three_from_four_back {
+            block.code(LENGTH_3);
+            block.code(DISTANCE_4);
+        }
+        block.code(END_OF_BLOCK);
+        if block.count > 0 {
+            block.put(0, 8 - block.count);
+        }
+        block.bytes
+    }
+}
+
+fn long_history() -> Vec<u8> {
+    (0..300_000u32).map(|n| b'a' + (n * 7 % 26) as u8).collect()
+}
+
+fn extracted_on_one_worker(entries: &[Raw]) -> (tempfile::TempDir, anyhow::Result<()>) {
+    use zipper::native_zip::{ReadOptions, read_archive_with_options};
+    let root = tempfile::tempdir().unwrap();
+    let archive = root.path().join("case.zip");
+    write_zip(&archive, entries);
+    let options = || ReadOptions {
+        threads: Some(1),
+        ..ReadOptions::default()
+    };
+    let verified = read_archive_with_options(&archive, None, options());
+    let extracted = read_archive_with_options(&archive, Some(&root.path().join("out")), options());
+    assert_eq!(verified.is_ok(), extracted.is_ok());
+    (root, extracted.map(drop))
+}
