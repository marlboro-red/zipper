+#[test]
+fn an_entry_cannot_reach_back_into_the_entry_before_it_on_the_same_worker() {
+    let history = long_history();
+    let mut through_the_entry_before = vec![b'x'];
+    through_the_entry_before.extend_from_slice(&history[history.len() - 3..]);
+    let entries = [
+        compressed(
+            "long",
+            &history,
+            DEFLATED,
+            FixedBlock::final_block(&history, false),
+        ),
+        compressed(
+            "reaching",
+            &through_the_entry_before,
+            DEFLATED,
+            FixedBlock::final_block(b"x", true),
+        ),
+    ];
+    let (root, extracted) = extracted_on_one_worker(&entries);
+    let error = extracted.expect_err("an entry read the entry before it");
+    assert!(
+        format!("{error:#}").contains("before the start of the data"),
+        "{error:#}"
+    );
+    assert!(
+        leftovers(root.path()).is_empty(),
+        "a refused extraction left output"
+    );
+}
