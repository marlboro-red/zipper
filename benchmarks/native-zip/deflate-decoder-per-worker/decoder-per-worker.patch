+pub(crate) type Parked = Inflate<()>;
+
+impl Parked {
+    pub(crate) const fn parked() -> Self {
+        Self {
+            window: (),
+            bits: Bits {
+                buffer: 0,
+                count: 0,
+            },
+            state: State::BlockHeader,
+            last_block: false,
+            dynamic: None,
+            uses_dynamic: false,
+            filled: 0,
+            total_in: 0,
+        }
+    }
+
+    pub(crate) fn resume<W: std::ops::DerefMut<Target = [u8]>>(&mut self, window: W) -> Inflate<W> {
+        assert!(window.len() >= SMALLEST_WINDOW);
+        let mut inflate = std::mem::replace(self, Self::parked()).moved_to(window);
+        inflate.restart();
+        inflate
+    }
+}
+
+impl<W> Inflate<W> {
+    fn moved_to<V>(self, window: V) -> Inflate<V> {
+        Inflate {
+            window,
+            bits: self.bits,
+            state: self.state,
+            last_block: self.last_block,
+            dynamic: self.dynamic,
+            uses_dynamic: self.uses_dynamic,
+            filled: self.filled,
+            total_in: self.total_in,
+        }
+    }
+
+    pub(crate) fn park(self) -> Parked {
+        self.moved_to(())
+    }
+}
