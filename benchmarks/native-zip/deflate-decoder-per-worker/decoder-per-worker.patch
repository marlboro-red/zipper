+#[test]
+fn an_entry_after_a_long_one_on_the_same_worker_decodes_as_if_alone() {
+    let history = long_history();
+    let fresh = b"fresh bytes";
+    let entries = [
+        compressed(
+            "long",
+            &history,
+            DEFLATED,
+            FixedBlock::final_block(&history, false),
+        ),
+        compressed(
+            "short",
+            fresh,
+            DEFLATED,
+            FixedBlock::final_block(fresh, false),
+        ),
+    ];
+    let (root, extracted) = extracted_on_one_worker(&entries);
+    extracted.unwrap();
+    assert_eq!(fs::read(root.path().join("out/long")).unwrap(), history);
+    assert_eq!(fs::read(root.path().join("out/short")).unwrap(), fresh);
+}
