        "tests/selection.rs::include_and_exclude_patterns_select_the_same_files_in_every_format"
      ]
    },
    "-snl": {
      "status": "native",
      "note": "Links that stay inside the destination are created. Windows needs Developer Mode or administrator rights.",
      "tests": [
        "tests/hostile_zip.rs::symlinks_inside_the_destination_are_created_after_files",
        "tests/hostile_zip.rs::symlinks_must_stay_inside_the_destination"
      ]
    },
    "-snh": {
      "status": "partial",
      "note": "Tar hard links are created. The other native readers meet none.",
      "tests": [
        "tests/hostile_tar.rs::links_stay_inside_and_never_carry_writes"
      ]
    },
    "-spf": {
      "status": "dropped",
